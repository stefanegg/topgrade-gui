{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Topgrade GUI",
  "version": "0.4.2",
  "identifier": "dev.topgradegui.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Topgrade GUI",
        "width": 1100,
        "height": 750,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Desktop wrapper for topgrade",
    "longDescription": "Runs topgrade in an embedded terminal, splits output into steps with results, lists what each step updated, keeps a history of runs and reminds you from the tray when an update is overdue.",
    "copyright": "Topgrade GUI contributors",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "rpm": {
        "depends": [
          "libappindicator-gtk3"
        ]
      }
    }
  },
  "mainBinaryName": "topgrade-gui",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlERjMxOEIzRDg4RjI2RTAKUldUZ0pvL1lzeGp6blVQbXpiNzZ5c2w1alVjVU9sWXJjNXNkaXBnbW1CR0ZTd25mOVJTSC8vVHYK",
      "endpoints": [
        "https://github.com/stefanegg/topgrade-gui/releases/latest/download/latest.json"
      ]
    }
  }
}
